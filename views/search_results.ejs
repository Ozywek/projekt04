<%- include("head.partial.ejs") %>
<%- include("forms/search_form.ejs") %>


<div id="search-results">
<% if (results.length === 0) { %>
  <p>Brak wyników</p>
<% } else { %>
  <ul>
    <% results.forEach(battle => { %>
      <li><a href="battle/<%= battle.id %>"><%= battle.name %></a></li>
    <% }) %>
  </ul>
<% } %>
</div>