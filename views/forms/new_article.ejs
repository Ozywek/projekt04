<h1>Dodaj nową bitwę</h1>

<form method="POST" action="/battle/new">

  <label>Nazwa bitwy:</label><br>
  <input type="text" name="name" required><br><br>

  <label>Rok:</label><br>
  <input type="number" name="year" required><br><br>

  <label>Opis:</label><br>
  <textarea name="description" required></textarea><br><br>

  <button type="submit">Dodaj bitwę</button>

</form>